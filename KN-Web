<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nicodeme KOUASSI - Web Designer Junior</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
}

body {
    background: linear-gradient(135deg, #0a0f1c, #05070f);
    color: white;
    overflow-x: hidden;
}

/* NAVBAR */
nav {
    display: flex;
    justify-content: space-between;
    padding: 20px 40px;
    position: fixed;
    width: 100%;
    backdrop-filter: blur(10px);
    background: rgba(0,0,0,0.3);
}

nav h2 {
    color: #2f6bff;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

/* HERO */
.hero {
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 10%;
}

.hero h1 {
    font-size: 60px;
}

.hero span {
    color: #2f6bff;
}

.hero p {
    margin: 20px 0;
    color: #aaa;
}

.btn {
    padding: 12px 25px;
    background: #2f6bff;
    border-radius: 30px;
    display: inline-block;
    text-decoration: none;
    color: white;
    transition: 0.3s;
}

.btn:hover {
    transform: scale(1.1);
}

/* CARDS */
.section {
    padding: 80px 10%;
}

.card {
    background: rgba(255,255,255,0.05);
    border-radius: 15px;
    padding: 30px;
    backdrop-filter: blur(10px);
    margin-bottom: 30px;
    transition: 0.4s;
}

.card:hover {
    transform: translateY(-10px);
}

/* SERVICES */
.services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
    gap: 20px;
}

/* FORM */
form {
    display: flex;
    flex-direction: column;
}

input, textarea {
    margin-bottom: 15px;
    padding: 12px;
    border-radius: 8px;
    border: none;
}

button {
    padding: 12px;
    border: none;
    background: #2f6bff;
    color: white;
    border-radius: 8px;
    cursor: pointer;
}

/* FOOTER */
footer {
    text-align: center;
    padding: 30px;
    color: #777;
}

/* ANIMATION */
.fade {
    opacity: 0;
    transform: translateY(40px);
    transition: 1s;
}

.fade.visible {
    opacity: 1;
    transform: translateY(0);
}
</style>
</head>

<body>

<nav>
    <h2>NK</h2>
    <div>
        <a href="#about">À propos</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
    </div>
</nav>

<section class="hero">
    <div>
        <h1>Nicodeme <span>KOUASSI</span></h1>
        <p>Web Designer Junior – Création de designs modernes et impactants.</p>
        <a href="#contact" class="btn">Me contacter</a>
    </div>
</section>

<section id="about" class="section fade">
    <div class="card">
        <h2>À propos</h2>
        <p>
            Je suis Web Designer Junior passionné par la création d’interfaces modernes,
            intuitives et performantes. Mon objectif est de transformer vos idées en
            expériences visuelles impactantes.
        </p>

        <br>

        <p>📧 nicodeme.kouassi1998@gmail.com</p>
        <p>📱 0770205210</p>
        <p>🌐 www.nicodemekouassi.com</p>
        <p>📍 France</p>
    </div>
</section>

<section id="services" class="section fade">
    <h2>Services</h2>

    <div class="services">
        <div class="card">Création de sites web</div>
        <div class="card">UI/UX Design</div>
        <div class="card">Branding digital</div>
        <div class="card">Design responsive</div>
    </div>
</section>

<section id="contact" class="section fade">
    <div class="card">
        <h2>Contact</h2>

        <form>
            <input type="text" placeholder="Nom" required>
            <input type="email" placeholder="Email" required>
            <textarea placeholder="Message" required></textarea>
            <button type="submit">Envoyer</button>
        </form>
    </div>
</section>

<footer>
    © 2026 Nicodeme KOUASSI - Web Designer Junior
</footer>

<script>
const faders = document.querySelectorAll('.fade');

window.addEventListener('scroll', () => {
    faders.forEach(el => {
        const rect = el.getBoundingClientRect();
        if(rect.top < window.innerHeight - 100){
            el.classList.add('visible');
        }
    });
});
</script>

</body>
</html>
